  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#centralwidget {
    background-color: #121212;
}

QWidget {
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;, &quot;SF Pro Display&quot;, sans-serif;
}

QFrame[frameShape=&quot;4&quot;] { /* Horizontal lines */
    border: none;
    border-top: 1px solid #2E2E2E;
    min-height: 1px; max-height: 1px;
}
QFrame[frameShape=&quot;5&quot;] { /* Vertical lines */
    border: none;
    border-left: 1px solid #2E2E2E;
    min-width: 1px; max-width: 1px;
}
QSplitter::handle { /* The draggable line between the sidebar and files */
    background-color: #222222;
}

#top_nav_bar {
    background-color: #1A1A1A;
    min-height: 52px;
    max-height: 52px;
}

QLineEdit#breadcrumb_bar, QLineEdit#main_search {
    background-color: #242424;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    padding: 4px 12px;
    color: #E0E0E0;
    font-size: 13px;
}

#btn_ai_command {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #D35400, stop:1 #E67E22);
    border-radius: 6px;
    padding: 5px 15px;
    font-weight: bold;
    color: white;
    font-size: 12px;
}
#btn_ai_command:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E67E22, stop:1 #F39C12);
}

#toolbar {
    background-color: #1A1A1A;
    min-height: 58px;
    max-height: 58px;
}

QToolButton, #toolbar QPushButton {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 5px 12px;
    color: #CCCCCC;
    font-size: 12px;
}
QToolButton:hover, #toolbar QPushButton:hover {
    background-color: #242424;
    color: #FFFFFF;
}

#toolbar QPushButton#new_folder {
    background-color: #0078D4;
    border-radius: 5px;
    padding: 6px 16px;
    font-weight: bold;
    font-size: 13px;
    color: #FFFFFF;
}
#toolbar QPushButton#new_folder:hover { background-color: #108AE6; }

#toolbar QPushButton#new_file {
    background-color: transparent;
    border: 1px solid #444444;
    border-radius: 5px;
    padding: 6px 16px;
    font-size: 13px;
    color: #FFFFFF;
}
#toolbar QPushButton#new_file:hover { background-color: #242424; }

#sidebar {
    background-color: #1A1A1A; 
    min-width: 200px;
    max-width: 260px;
}

#sidebar QPushButton {
    text-align: left;
    padding: 8px 12px;
    background: transparent;
    border: none;
    border-radius: 5px;
    color: #A0A0A0;
    font-size: 13px;
}
#sidebar QPushButton:hover {
    background-color: #242424;
    color: #FFFFFF;
}
#sidebar QPushButton:checked {
    background-color: #213045;
    color: #60A5FA;
}

QTreeWidget#side_panel_3 {
    background-color: transparent;
    border: none;
    outline: none;
}

#main_scroll_area {
    background-color: #121212; 
}

#status_bar {
    background-color: #1A1A1A;
    min-height: 26px;
    max-height: 26px;
}

#status_bar QLabel {
    color: #888888;
    font-size: 11px;
    font-weight: 500;
}

#status_bar QPushButton {
    background: transparent;
    border: none;
    color: #888888;
    font-size: 11px;
    padding: 2px 10px;
    border-radius: 4px;
}

#status_bar QPushButton:hover {
    color: #FFFFFF;
    background-color: #242424; 
}

QSplitter::handle {
    background-color: #2E2E2E; 
}</string>
