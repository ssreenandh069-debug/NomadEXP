  <property name="styleSheet">
   <string notr="true">#quick_search_frame {
    background-color: #1e1e1e;
    border: 1px solid #4f5a61; 
    border-radius: 12px;       
}

QLineEdit {
    background: transparent;
    font-size: 20px;
    color: #FFFFFF;
}

#filter_bar {
	background:#121212;
	border-radius:5px;
}

#filter_bar QPushButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 12px; 
    padding: 6px 14px;
    color: #A0A0A0;
    font-size: 13px;
    font-weight: bold;
}

#filter_bar QPushButton:hover {
    background-color: #2A2A2A;
    color: #FFFFFF;
	border: 1px solid transparent;
	border-radius: 15px;
}

#filter_bar QPushButton:checked {
    background-color: #0078d4; 
    color: #FFFFFF;
	border: 1px solid #0078D4;
	border-radius: 15px;
}
QFrame[frameShape=&quot;4&quot;] {  /*horizontal Lines*/
    border:none;
	border-top: 1px solid #4f5a61;
    background-color: #4f5a61; 
    min-height: 1px;
    max-height: 1px;
}
QFrame[frameShape=&quot;5&quot;] { /*vertical Lines*/
    border: none;
	border-left: 1px solid #4f5a61;
    background-color: #4f5a61;
    min-width: 1px;
    max-width: 1px;
}
#search_bar QPushButton{
	background:transparent;
}
#search_bar QPushButton:hover{
	background:#313131;
}

#open_file {
    background-color: #0078D4;
    color: white;
    border-radius: 6px;
    padding: 10px;
    font-size: 13px;
    font-weight: bold;
}
#open_file:hover {
    background-color: #108AE6;
}

#open_file_location {
    background-color: transparent;
    color: #FFFFFF;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 10px;
    font-size: 13px;
}

#open_file_location:hover {
    background-color: #2A2A2A;
}

#metadata QLabel {
    color: #CCCCCC;
}

#result_list {
    background: transparent;
    border: none;
    outline: none;
}

#result_list::item {
    color: #E0E0E0;
    padding: 8px 12px; 
    border-radius: 6px; 
    margin: 2px 5px; 
}

#result_list::item:hover {
    background-color: #2A2A2A;
}

#result_list::item:selected {
    background-color: #333333;
    border-left: 3px solid #0078D4;
}</string>
